# Server
PORT=3000
BASE_URL=http://localhost:3000
OWNER_KEY=
DATA_FILE=data/innkeeper.json

# PayPal: mock | sandbox | live
# mock needs no credentials and simulates every PayPal call locally.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: set after creating a webhook in the PayPal developer dashboard pointing at BASE_URL/webhooks/paypal
PAYPAL_WEBHOOK_ID=
CURRENCY=USD
BRAND_NAME=Cinnamon Ridge Stays

# AI. Pick one; leave all keys empty to run the deterministic scripted agents (useful for judges without a key).
# Option A: Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Option B: any OpenAI-compatible endpoint with tool calling (free tiers: Groq, Google Gemini)
#   Groq:   OPENAI_BASE_URL=https://api.groq.com/openai/v1   OPENAI_MODEL=llama-3.3-70b-versatile   OPENAI_LABEL=groq
#   Gemini: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   OPENAI_MODEL=gemini-2.5-flash   OPENAI_LABEL=gemini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_LABEL=openai
# Force a provider: anthropic | openai | scripted (default: auto-detect from the keys above)
AI_PROVIDER=auto
AGENT_MAX_TURNS=12

# Money loop scheduler interval in milliseconds
JOBS_INTERVAL_MS=60000
