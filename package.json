{
  "name": "innkeeper",
  "version": "0.1.0",
  "description": "AI front desk for independent stays: books, collects, refunds and pays out on PayPal, and is bookable by other AI agents over MCP.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "seed": "node src/seed.js --reset",
    "traveler": "node scripts/traveler-demo.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^4.0.0"
  },
  "license": "MIT"
}
